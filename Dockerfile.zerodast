FROM node:20-alpine

RUN apk add --no-cache python3 make g++ git

WORKDIR /app

ENV CI=true

RUN git clone --depth 1 --branch master https://github.com/medusajs/medusa-starter-default.git . && \
    rm -rf .git

RUN npm install --legacy-peer-deps

# Production build + align admin output with what `medusa start` serves (./public/admin).
# The compiler emits the dashboard under .medusa/server/public/admin; the admin loader reads project-root public/admin.
RUN NODE_ENV=production npm run build && \
    mkdir -p public && \
    if [ -d .medusa/server/public/admin ]; then \
      rm -rf public/admin && cp -a .medusa/server/public/admin public/admin; \
    fi && \
    test -f public/admin/index.html

COPY zerodast/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 9000

CMD ["/app/entrypoint.sh"]
