FROM node:20-alpine

RUN apk add --no-cache python3 make g++ git

WORKDIR /app

ENV CI=true

RUN git clone --depth 1 --branch master https://github.com/medusajs/medusa-starter-default.git . && \
    rm -rf .git

RUN npm install --legacy-peer-deps

COPY zerodast/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 9000

CMD ["/app/entrypoint.sh"]
